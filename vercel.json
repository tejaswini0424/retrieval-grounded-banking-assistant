{
  "framework": null,
  "outputDirectory": "web",
  "functions": {
    "api/index.py": { "includeFiles": "knowledge.json" }
  },
  "rewrites": [
    { "source": "/api/:path*", "destination": "/api/index?bank_route=:path*" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Content-Security-Policy", "value": "default-src 'self'; frame-ancestors 'none'; base-uri 'none'; form-action 'self'" }
      ]
    }
  ]
}
